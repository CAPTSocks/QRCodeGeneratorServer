<UserControl x:Class="QRCodeGenerator.RaceSetup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">

    <UserControl.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#B0B0B0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#F3F3F3"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="CaretBrush" Value="#F3F3F3"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#F3F3F3"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E85D04"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="SecondaryButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#3F3F46"/>
        </Style>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Race Setup"
                       FontSize="26"
                       FontWeight="Bold"/>

            <TextBlock Text="Configure the race and connect your racers."
                       Foreground="#9A9A9A"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: RACE SETTINGS -->
            <Border Grid.Column="0"
                    Style="{StaticResource PanelStyle}">

                <StackPanel>
                    <TextBlock Text="Race Settings"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Race Name"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox x:Name="RaceNameBox"
                             Text="Main Event"
                             Margin="0,0,0,18"/>

                    <TextBlock Text="Heat"
                               Style="{StaticResource FieldLabel}"/>

                    <ComboBox x:Name="HeatBox"
                              SelectedIndex="0"
                              Margin="0,0,0,18">
                        <ComboBoxItem Content="Heat 1"/>
                        <ComboBoxItem Content="Heat 2"/>
                        <ComboBoxItem Content="Heat 3"/>
                        <ComboBoxItem Content="Heat 4"/>
                        <ComboBoxItem Content="Final"/>
                    </ComboBox>

                    <TextBlock Text="Race Length"
                               Style="{StaticResource FieldLabel}"/>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="DurationBox"
                                 Text="10"
                                 Margin="0,0,8,0"/>

                        <ComboBox x:Name="DurationUnitBox"
                                  Grid.Column="1"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Minutes"/>
                            <ComboBoxItem Content="Laps"/>
                        </ComboBox>
                    </Grid>

                    <TextBlock Text="Race Options"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,12"/>

                    <CheckBox x:Name="PracticeCheckbox"
                              Content="Practice Race"
                              IsChecked="False"/>

                    <CheckBox x:Name="IncludeFuelCheckBox"
                              Content="Include Fuel"
                              IsChecked="True"/>

                    <CheckBox x:Name="AllowPausingCheckBox"
                              Content="Allow Pausing"
                              IsChecked="True"/>
                </StackPanel>
            </Border>

            <!-- RIGHT: SERVER -->
            <Border Grid.Column="2"
                    Style="{StaticResource PanelStyle}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Server Connection"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

                    <!-- Status and start button -->
                    <StackPanel Grid.Row="1">

                        <TextBlock x:Name="ServerStatusText"
                                   Text="Server Offline"
                                   Foreground="#E57373"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <Button x:Name="StartServerButton"
                                Content="Start Server"
                                Style="{StaticResource PrimaryButton}"
                                Height="44"
                                Click="StartServerButton_Click"
                                Margin="0,0,0,12"/>

                        <TextBlock x:Name="ServerAddressText"
                                   Text="Start the server to generate a QR code."
                                   Foreground="#A0A0A0"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"/>
                    </StackPanel>

                    <!-- QR Code -->
                    <Border Grid.Row="2"
                            Background="White"
                            CornerRadius="6"
                            Padding="12"
                            Width="190"
                            Height="190"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,20">

                        <Image x:Name="QrImage"
                               Stretch="Uniform"/>
                    </Border>

                    <!-- Connected clients -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="ConnectedClientsTitle"
                                   Grid.Row="0"
                                   Text="Connected Racers (0)"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <ListBox x:Name="ConnectedClientsBox"
                                 Grid.Row="1"
                                 MinHeight="100"
                                 Background="#2D2D30"
                                 Foreground="#F3F3F3"
                                 BorderBrush="#3F3F46"
                                 BorderThickness="1"
                                 Padding="8"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom action -->
        <Button x:Name="SetupRaceButton"
                Grid.Row="2"
                Content="Setup Race"
                Style="{StaticResource PrimaryButton}"
                Height="52"
                HorizontalAlignment="Stretch"
                Margin="0,20,0,0"
                Click="SetupRaceButton_Click"
                IsEnabled="False"/>

    </Grid>
</UserControl>
