<UserControl x:Class="QRCodeGenerator.RaceStatus"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:QRCodeGenerator"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="800"
             Background="#1E1E1E">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#E8E8E8" />
            <Setter Property="FontSize"
                    Value="14" />
        </Style>

        <Style x:Key="SectionLabel"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#B0B0B0" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Margin"
                    Value="0,0,0,12" />
        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#E85D04" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Padding"
                    Value="18,10" />
            <Setter Property="FontSize"
                    Value="15" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>



    <Grid Margin="32,32,32,0">
        <Border Background="#252526"
                BorderBrush="#3F3F46"
                BorderThickness="1"
                CornerRadius="8"
                Padding="28"
                MaxWidth="600"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <!-- Page title -->
                <TextBlock Text="Race Status"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28" />

                <!-- Countdown timer -->
                <Border Background="#1E1E1E"
                        BorderBrush="#3F3F46"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="24"
                        Margin="0,0,0,24">

                    <StackPanel>
                        <TextBlock Text="TIME REMAINING"
                                   Foreground="#9A9A9A"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />

                        <TextBlock x:Name="TimeRemainingText"
                                   Text="10:00"
                                   FontSize="56"
                                   FontWeight="Bold"
                                   FontFamily="Consolas"
                                   HorizontalAlignment="Center"
                                   Foreground="#E85D04" />

                        <TextBlock x:Name="LapCountText"
                                    Text="Laps 0/0"
                                    FontSize="56"
                                    FontWeight="Bold"
                                    FontFamily="Consolas"
                                    HorizontalAlignment="Center"
                                    Foreground="#E85D04"
                                    Visibility="Collapsed"/>

                        <TextBlock x:Name="RaceStateText"
                                   Text="Waiting to start"
                                   FontSize="14"
                                   Foreground="#B0B0B0"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- Latest event/status -->
                <TextBlock Text="Latest Race Activity"
                           Style="{StaticResource SectionLabel}" />

                <Border Background="#1E1E1E"
                        BorderBrush="#3F3F46"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16"
                        MinHeight="120">

                    <StackPanel>
                        <TextBlock x:Name="LatestEventTitle"
                                   Text="No activity yet"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />

                        <TextBlock x:Name="LatestEventDetails"
                                   Text="Race events will appear here."
                                   Foreground="#B0B0B0"
                                   FontSize="14"
                                   TextWrapping="Wrap" />


                    </StackPanel>
                </Border>

                <Border x:Name="ResumeRaceBorder"
                        Background="#1E1E1E"
                        BorderBrush="#3F3F46"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16"
                        MinHeight="120"
                        Visibility="Collapsed">

                    <StackPanel>

                        <Button x:Name="ResumeRaceButton"
                                Width="107"
                                Height="30"
                                Click="ResumeRace_Click"
                                Margin="10,0,0,0">Resume Race</Button>
                    </StackPanel>
                </Border>

                <Border x:Name="StartRaceBorder"
                        Background="#1E1E1E"
                        BorderBrush="#3F3F46"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16"
                        MinHeight="120">

                    <StackPanel>
                        <Button x:Name="StartRaceButton"
                                Style="{StaticResource PrimaryButton}"
                                Width="auto"
                                Height="auto"
                                Click="StartRaceButton_Click"
                                Content="Start Race" />
                    </StackPanel>
                </Border>



            </StackPanel>
        </Border>
    </Grid>
</UserControl>