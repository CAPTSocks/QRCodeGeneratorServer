<UserControl x:Class="QRCodeGenerator.RaceSimulator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:QRCodeGenerator"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="800"
             Background="#1E1E1E">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#B0B0B0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#F3F3F3"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="CaretBrush" Value="#F3F3F3"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#F3F3F3"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <!-- Checkbox styling -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E85D04"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#3F3F46"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32">
        <Border Background="#252526"
                BorderBrush="#3F3F46"
                BorderThickness="1"
                CornerRadius="8"
                Padding="28"
                MaxWidth="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock Text="Race Setup"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>

                <TextBlock Text="Set the name, heat, and length, then start."
                           Foreground="#9A9A9A"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <TextBlock Text="Race name"
                           Style="{StaticResource FieldLabel}"/>

                <TextBox x:Name="RaceNameBox"
                         Text="Main Event"
                         Margin="0,0,0,16"/>

                <TextBlock Text="Heat"
                           Style="{StaticResource FieldLabel}"/>

                <ComboBox x:Name="HeatBox"
                          SelectedIndex="0"
                          Margin="0,0,0,16">
                    <ComboBoxItem Content="Heat 1"/>
                    <ComboBoxItem Content="Heat 2"/>
                    <ComboBoxItem Content="Heat 3"/>
                    <ComboBoxItem Content="Heat 4"/>
                    <ComboBoxItem Content="Final"/>
                </ComboBox>

                <TextBlock Text="How long the race goes"
                           Style="{StaticResource FieldLabel}"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="DurationBox"
                             Text="10"
                             Margin="0,0,8,0"/>

                    <ComboBox x:Name="DurationUnitBox"
                              Grid.Column="1"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Minutes"/>
                        <ComboBoxItem Content="Laps"/>
                    </ComboBox>
                </Grid>

                <!-- Race options -->
                <TextBlock Text="Race options"
                           Style="{StaticResource FieldLabel}"
                           Margin="0,0,0,12"/>

                <CheckBox x:Name="IncludeFuelCheckBox"
                          Content="Include fuel"
                          IsChecked="True"/>

                <CheckBox x:Name="AllowPausingCheckBox"
                          Content="Allow pausing"
                          IsChecked="True"
                          Margin="0,0,0,24"/>

                <Button Content="Setup Race"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch"
                        Click="SetupRaceButton_Click"
                        Margin="0,0,0,8"/>

                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Stretch"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>